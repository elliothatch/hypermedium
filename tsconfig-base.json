{
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",

		"rootDir": "${configDir}/src",
		"outDir": "${configDir}/build",
		"sourceMap": true,

		"declaration": true,
		"declarationMap": true,
		"declarationDir": "${configDir}/types",

		"preserveConstEnums": true,
		"verbatimModuleSyntax": true,

		"noImplicitOverride": true,
		"isolatedDeclarations": true,

		"types": ["node"]
	},
	"typedocOptions": {
		"entryPoints": ["src/index.ts"],
		"out": "docs"
	},
	"include": [
		"${configDir}/src/**/*",
		"${configDir}/lib/**/*"
	]
}
